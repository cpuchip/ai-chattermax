# Example persona-host config for ai-chattermax (the pg-ai-stewards reference host).
# Copy the relevant lines into the host's .env. See examples/README.md for the
# full flow (mint a key in the UI → grant a channel → configure → run).

# The platform's gateway (wss in prod).
CHATTERMAX_GATEWAY=wss://chat.ibeco.me

# Personas this host drives: comma-separated "localPersonaSlug=personaKey".
# The localPersonaSlug is the host's persona row (its character + pipeline);
# the key is what you minted in the UI. The host discovers granted rooms via
# GET /api/persona/rooms and is present in all of them.
#
#   one persona:
CHATTERMAX_PERSONAS=my-bot=cmk_REPLACE_WITH_YOUR_KEY
#   several:
# CHATTERMAX_PERSONAS=my-bot=cmk_aaa,research-bot=cmk_bbb

# --- Choosing the model backend (set on the persona row, not here) ----------
# The persona's `pipeline` column picks model + provider:
#   persona-turn            -> kimi-k2.6 / opencode_go (default; no tools)
#   persona-turn-lmstudio   -> qwen3.6-27b via local LM Studio (host.docker.internal:1234) — verified
#   persona-turn-gemini     -> gemini-3.5-flash via Google Gemini
# e.g. for an LM Studio-backed persona:
#   INSERT INTO persona_host.personas (slug, display_name, agent_family, persona_prompt, pipeline)
#   VALUES ('my-bot','My Bot','fiction','<character>','persona-turn-lmstudio')
#   ON CONFLICT (slug) DO UPDATE SET pipeline = EXCLUDED.pipeline, persona_prompt = EXCLUDED.persona_prompt;

# The substrate DSN the host uses for cognition (the reference host runs inside
# the substrate compose, so this points at the internal pg service).
# STEWARDS_DSN=postgres://stewards:...@pg:5432/stewards?sslmode=disable
